{
  "name": "3d-room-roaming",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "video": "remotion preview src/remotion/index.ts",
    "video:render": "remotion render src/remotion/index.ts GuidedTour out/3D-SmartTour-Showcase.mp4",
    "video:build-web": "remotion render src/remotion/index.ts WebBackground public/videos/3D-SmartTour-web-bg.mp4 --crf=28 --codec=h264 --pixel-format=yuv420p",
    "video:poster": "remotion still src/remotion/index.ts WebBackground public/videos/poster.jpg --frame=0"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "@react-three/rapier": "^1.3.0",
    "@remotion/cli": "^4.0.418",
    "@remotion/three": "^4.0.418",
    "clsx": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.418",
    "tailwind-merge": "^2.2.2",
    "three": "^0.163.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.10",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^4.0.10"
  }
}